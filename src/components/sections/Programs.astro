---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const programs = t.programsData;
---

<section class="bg-background py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-semibold text-text sm:text-4xl">{t.programs.title}</h2>
      <p class="mt-4 text-base leading-relaxed text-text-muted sm:text-lg">
        {t.programs.description}
      </p>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {programs.map((program) => (
        <article class="group flex flex-col overflow-hidden rounded-3xl border border-border bg-surface shadow-sm transition hover:-translate-y-1 hover:shadow-md">
          <div class="aspect-[4/3] overflow-hidden bg-soft-yellow">
            <img
              src={program.image}
              alt={program.imageAlt}
              width="640"
              height="480"
              loading="lazy"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />
          </div>
          <div class="flex flex-1 flex-col p-6">
            <span class="text-xs font-semibold uppercase tracking-wider text-primary">{program.ageRange}</span>
            <h3 class="mt-2 font-display text-xl font-semibold text-text">{program.name}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-text-muted">{program.description}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {program.focus.map((f) => (
                <li class="rounded-full bg-soft-yellow px-3 py-1 text-xs font-medium text-text">{f}</li>
              ))}
            </ul>
            <a href={lang === 'en' ? '/en/programs' : '/programs'} class="mt-6 inline-flex items-center text-sm font-semibold text-primary hover:text-primary-hover">
              {t.programs.learnMore}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>