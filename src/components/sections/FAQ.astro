---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import FAQAccordion from '../vue/FAQAccordion.vue';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="faq" class="bg-background py-20 lg:py-28">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <h2 class="font-display text-3xl font-semibold text-text sm:text-4xl text-center">{t.faq.title}</h2>
    <p class="mt-4 text-center text-base text-text-muted">
      {t.faq.description}
    </p>
    <div class="mt-10">
      <FAQAccordion client:visible items={t.faq.items} />
    </div>
  </div>
</section>
