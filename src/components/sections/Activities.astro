---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="bg-background py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-semibold text-text sm:text-4xl">{t.activities.title}</h2>
      <p class="mt-4 text-base leading-relaxed text-text-muted sm:text-lg">
        {t.activities.description}
      </p>
    </div>

    <ol class="mt-12 relative border-l-2 border-primary/30 pl-8 space-y-10">
      {t.activities.items.map((item, i) => (
        <li class="relative">
          <span class="absolute -left-[41px] flex h-6 w-6 items-center justify-center rounded-full bg-primary text-xs font-bold text-white">
            {i + 1}
          </span>
          <h3 class="font-display text-lg font-semibold text-text">{item.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-text-muted">{item.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
