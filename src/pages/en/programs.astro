---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import Programs from '../../components/sections/Programs.astro';
import FAQ from '../../components/sections/FAQ.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import { useTranslations } from '../../i18n/ui';
const t = useTranslations('en');
---

<BaseLayout title={t.pages.programsTitle} description={t.pages.programsDesc} canonical="/en/programs">
  <Navbar />
  <main class="pt-28">
    <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
      <h1 class="font-display text-4xl font-semibold text-text">{t.pages.programsHeading}</h1>
      <p class="mt-6 text-base leading-relaxed text-text-muted">{t.pages.programsP}</p>
    </section>
    <Programs />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>
