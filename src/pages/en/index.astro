---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import Hero from '../../components/sections/Hero.astro';
import Philosophy from '../../components/sections/Philosophy.astro';
import Programs from '../../components/sections/Programs.astro';
import MontessoriApproach from '../../components/sections/MontessoriApproach.astro';
import Activities from '../../components/sections/Activities.astro';
import Gallery from '../../components/sections/Gallery.astro';
import Admission from '../../components/sections/Admission.astro';
import FAQ from '../../components/sections/FAQ.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import { useTranslations } from '../../i18n/ui';
const t = useTranslations('en');
---

<BaseLayout title={t.pages.homeTitle} description={t.pages.homeDesc} canonical="/en/">
  <Navbar />
  <main>
    <Hero />
    <Philosophy />
    <Programs />
    <MontessoriApproach />
    <Activities />
    <Gallery />
    <Admission />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>
