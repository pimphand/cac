---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import Philosophy from '../../components/sections/Philosophy.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import { useTranslations } from '../../i18n/ui';
const t = useTranslations('en');
---

<BaseLayout title={t.pages.aboutTitle} description={t.pages.aboutDesc} canonical="/en/about">
  <Navbar />
  <main class="pt-28">
    <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
      <h1 class="font-display text-4xl font-semibold text-text">{t.pages.aboutHeading}</h1>
      <p class="mt-6 text-base leading-relaxed text-text-muted">{t.pages.aboutP1}</p>
      <h2 class="mt-10 font-display text-2xl font-semibold text-text">{t.pages.philosophyHeading}</h2>
      <p class="mt-4 text-base leading-relaxed text-text-muted">{t.pages.philosophyP}</p>
      <h2 class="mt-10 font-display text-2xl font-semibold text-text">{t.pages.envHeading}</h2>
      <p class="mt-4 text-base leading-relaxed text-text-muted">{t.pages.envP}</p>
      <h2 class="mt-10 font-display text-2xl font-semibold text-text">{t.pages.educatorHeading}</h2>
      <p class="mt-4 text-base leading-relaxed text-text-muted">{t.pages.educatorP}</p>
    </section>
    <Philosophy />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>
