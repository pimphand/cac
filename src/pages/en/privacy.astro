---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import { useTranslations } from '../../i18n/ui';
const t = useTranslations('en');
---

<BaseLayout title={t.pages.privacyTitle} description={t.pages.privacyDesc} canonical="/en/privacy">
  <Navbar />
  <main class="pt-28">
    <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
      <h1 class="font-display text-4xl font-semibold text-text">{t.pages.privacyHeading}</h1>
      <p class="mt-6 text-base leading-relaxed text-text-muted">{t.pages.privacyP}</p>
    </section>
  </main>
  <Footer />
</BaseLayout>
