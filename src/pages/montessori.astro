---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import MontessoriApproach from '../components/sections/MontessoriApproach.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
---

<BaseLayout title="Montessori Approach — CAC Montessori Madiun" description="Memahami prinsip Montessori dan manfaatnya bagi anak usia dini." canonical="/montessori">
  <Navbar />
  <main class="pt-28">
    <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
      <h1 class="font-display text-4xl font-semibold text-text">Montessori Approach</h1>
      <p class="mt-6 text-base leading-relaxed text-text-muted">
        Halaman edukatif bagi orang tua yang ingin memahami prinsip Montessori dan manfaatnya bagi anak usia dini.
      </p>
    </section>
    <MontessoriApproach />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>