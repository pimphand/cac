---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Admission from '../components/sections/Admission.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
---

<BaseLayout title="Contact & Admission — CAC Montessori Madiun" description="Informasi kontak dan pendaftaran CAC Montessori Madiun." canonical="/contact">
  <Navbar />
  <main class="pt-28">
    <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
      <h1 class="font-display text-4xl font-semibold text-text">Contact &amp; Admission</h1>
      <p class="mt-6 text-base leading-relaxed text-text-muted">
        Informasi kontak, formulir konsultasi, dan informasi waiting list kelas reguler.
      </p>
    </section>
    <Admission />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>