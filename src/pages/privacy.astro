---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
---

<BaseLayout title="Privacy Policy — CAC Montessori Madiun" description="Kebijakan privasi CAC Montessori Madiun." canonical="/privacy">
  <Navbar />
  <main class="pt-28">
    <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
      <h1 class="font-display text-4xl font-semibold text-text">Privacy Policy</h1>
      <p class="mt-6 text-base leading-relaxed text-text-muted">
        Informasi pribadi yang dikirimkan melalui formulir akan digunakan untuk keperluan komunikasi dan informasi ketersediaan kelas. Data anak tidak disimpan di browser. Kebijakan lengkap akan diperbarui sesuai ketentuan sekolah.
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>